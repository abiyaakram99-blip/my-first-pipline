pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                echo 'Code GitHub se aa gaya!'
            }
        }
        stage('Build') {
            steps {
                echo 'Build ho raha hai...'
            }
        }
        stage('Test') {
            steps {
                echo 'Testing ho rahi hai...'
            }
        }
        stage('Deploy') {
            steps {
                echo 'Deploy ho gaya! Website Ready hai!'
            }
        }
    }
}
